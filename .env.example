PORT=4317
ELYSIUM_RPC_URL=https://rpc.elysium.kinetiq.xyz
OG_API_KEY=
OG_MODEL=
OG_BASE_URL=https://router-api.0g.ai/v1

# Public Privy identifier only. Never put the app secret in browser config.
PRIVY_APP_ID=
# Public/browser-safe HTTPS RPC. Never copy a secret-bearing server RPC here.
ELYSIUM_PUBLIC_RPC_URL=https://rpc.elysium.kinetiq.xyz

# Keep disabled until provider setup, live read-only checks and dependency review are complete.
ENABLE_LIVE_LAUNCH=false

# Published policy URLs replace the local draft pages when both are configured.
DINN_TERMS_URL=
DINN_PRIVACY_URL=

# 99801 enables testnet onboarding only; launch contracts remain pinned to 99901.
ELYSIUM_AUTH_CHAIN_ID=99901

# Official public mainnet RPC supports general EVM transactions. Use a dedicated provider for production.
# Montra RPC remains supported for Montra-only sends; it cannot enable Ascend actions.
ENABLE_WALLET_TRANSFERS=false
ENABLE_LOCAL_SWAP_PREVIEW=false
ELYSIUM_MARKET_RPC_URL=https://rpc.elysium.kinetiq.xyz

# Enable only after wallet review and fork verification; Montra native-HYPE pools only.
ENABLE_MONTRA_SWAPS=false

# Discover Montra holdings and verify balances onchain.
ELYSIUM_DISCOVER_HOLDINGS=true

# Standard CreatorEscrow settle/claim; requires a recognized general mainnet route.
ENABLE_ASCEND_FEES=false

# Current product: Pons first. Elysium adapters retained but paused.
ELYSIUM_PAUSED=true
DINN_AUTH_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Blockscout authenticated Robinhood holder/portfolio/source reads (server only)
BLOCKSCOUT_API_KEY=
# Logo creation (0G). Keep production disabled until access rules and live tests pass.
DINN_LOGOS_ENABLED=false
OG_IMAGE_MODEL=z-image-turbo
# Optional image-enabled key; otherwise uses OG_API_KEY.
OG_IMAGE_API_KEY=
DINN_LOGO_DAILY_LIMIT=5
# Production pilot: comma-separated verified Privy user IDs. No NFT/staking entitlement implied.
DINN_LOGO_TEST_USERS=
DATABASE_URL=
# Stable canonical HTTPS origin; Render's external URL is a fallback.
DINN_PUBLIC_URL=
# Local PC only; ignored on Render or NODE_ENV=production.
DINN_LOGO_LOCAL_TEST=false
DINN_LOGO_LOCAL_DB=
